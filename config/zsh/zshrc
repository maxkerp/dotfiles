# ── ~/.config/zsh/.zshrc ──────────────────────────────────────────────────────
# Entry point for interactive zsh shells.  Delegates to modular files in
# config/ (sourced before compinit) and config-post/ (sourced after),
# adds share/zsh/functions/ + completions/ to fpath, and launches integrations.
# Drop a new NN-name.zsh into config/ or config-post/ to add functionality
# — nothing else to wire up.
# ───────────────────────────────────────────────────────────────────────────────

# ── options (must come first) ──────────────────────────────────────────────────
setopt extendedglob

# ── dotfiles root (overridable via env) ───────────────────────────────────────
: ${DOTFILES_ROOT_DIR:=$HOME/Git/dotfiles}

# ── config modules (sourced in sorted order) ───────────────────────────────────
for f in "$ZDOTDIR"/config/*.zsh(N-.); do source "$f"; done

# ── fpath: functions (autoloaded lazily) and completions (picked up by compinit)
fpath=(
  "$DOTFILES_ROOT_DIR/share/zsh/functions"
  "$HOME/.local/share/zsh/functions"
  "$ZDOTDIR/completions"
  $fpath
)

for dir in "$DOTFILES_ROOT_DIR/share/zsh/functions" "$HOME/.local/share/zsh/functions"; do
  [[ -d "$dir" ]] && for f in "$dir"/*(N-.); do autoload -Uz "${f:t}"; done
done

# ── completions ────────────────────────────────────────────────────────────────
autoload -Uz compinit
if [[ -n "$ZSH_CACHE_DIR/.zcompdump"(#qNmh-20) ]]; then
  compinit -C -d "$ZSH_CACHE_DIR/.zcompdump"
else
  compinit -d "$ZSH_CACHE_DIR/.zcompdump"
  # compile the dump for even faster subsequent loads
  zcompile "$ZSH_CACHE_DIR/.zcompdump" 2>/dev/null
fi

# ── post-compinit modules (carapace, etc.) ──────────────────────────────────────
for f in "$ZDOTDIR"/config-post/*.zsh(N-.); do source "$f"; done

# ── deduplicate PATH ────────────────────────────────────────────────────────────
typeset -gU PATH

# ── local machine config (not tracked in git) ──────────────────────────────────
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# ── secrets / API keys (not tracked, chmod 0600) ───────────────────────────────
[[ -f ~/.zsh.secrets ]] && source ~/.zsh.secrets
