#compdef tinty
# generated by tinty generate-completion zsh

local -a _tinty_commands
_tinty_commands=(
  "apply:Apply a scheme"
  "build:Build a template"
  "config:Print tinty configuration"
  "current:Print current scheme"
  "cycle:Cycle to the next scheme"
  "generate-completion:Generate shell completions"
  "generate-scheme:Generate a scheme from an image"
  "gallery:Open the gallery"
  "help:Show help"
  "info:Show scheme info"
  "init:Re-apply the current scheme"
  "list:List available schemes"
  "sync:Sync templates and schemes"
  "update:Update templates and schemes"
)

_tinty() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments \
    '1: :->command' \
    '*: :->args'

  case $state in
    command)
      _describe -t commands 'tinty commands' _tinty_commands
      ;;
  esac
}

_tinty "$@"
