#!/bin/sh
# Post-apply hook for tinty.
# Generates configs for tools without official tinty templates.
set -eu

# tinty *_HEX vars without suffix contain only the red component.
# We need _HEX_{R,G,B} concatenated for full 6-digit hex.
# Defaults are base16-catppuccin-mocha (last applied scheme at install time).
hex00="${TINTY_SCHEME_PALETTE_BASE00_HEX_R:-1e}${TINTY_SCHEME_PALETTE_BASE00_HEX_G:-1e}${TINTY_SCHEME_PALETTE_BASE00_HEX_B:-2e}"
hex01="${TINTY_SCHEME_PALETTE_BASE01_HEX_R:-18}${TINTY_SCHEME_PALETTE_BASE01_HEX_G:-18}${TINTY_SCHEME_PALETTE_BASE01_HEX_B:-25}"
hex04="${TINTY_SCHEME_PALETTE_BASE04_HEX_R:-58}${TINTY_SCHEME_PALETTE_BASE04_HEX_G:-5b}${TINTY_SCHEME_PALETTE_BASE04_HEX_B:-70}"
hex05="${TINTY_SCHEME_PALETTE_BASE05_HEX_R:-cd}${TINTY_SCHEME_PALETTE_BASE05_HEX_G:-d6}${TINTY_SCHEME_PALETTE_BASE05_HEX_B:-f4}"
hex08="${TINTY_SCHEME_PALETTE_BASE08_HEX_R:-f3}${TINTY_SCHEME_PALETTE_BASE08_HEX_G:-8b}${TINTY_SCHEME_PALETTE_BASE08_HEX_B:-a8}"
hex09="${TINTY_SCHEME_PALETTE_BASE09_HEX_R:-fa}${TINTY_SCHEME_PALETTE_BASE09_HEX_G:-b3}${TINTY_SCHEME_PALETTE_BASE09_HEX_B:-87}"
hex0A="${TINTY_SCHEME_PALETTE_BASE0A_HEX_R:-f9}${TINTY_SCHEME_PALETTE_BASE0A_HEX_G:-e2}${TINTY_SCHEME_PALETTE_BASE0A_HEX_B:-af}"
hex0B="${TINTY_SCHEME_PALETTE_BASE0B_HEX_R:-a6}${TINTY_SCHEME_PALETTE_BASE0B_HEX_G:-e3}${TINTY_SCHEME_PALETTE_BASE0B_HEX_B:-a1}"
hex0C="${TINTY_SCHEME_PALETTE_BASE0C_HEX_R:-94}${TINTY_SCHEME_PALETTE_BASE0C_HEX_G:-e2}${TINTY_SCHEME_PALETTE_BASE0C_HEX_B:-d5}"
hex0D="${TINTY_SCHEME_PALETTE_BASE0D_HEX_R:-89}${TINTY_SCHEME_PALETTE_BASE0D_HEX_G:-b4}${TINTY_SCHEME_PALETTE_BASE0D_HEX_B:-fa}"

LSD_THEME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lsd/themes"
LSD_THEME_FILE="$LSD_THEME_DIR/base16.yaml"

# ---- lsd theme ----
mkdir -p "$LSD_THEME_DIR"

cat > "$LSD_THEME_FILE" <<EOF
# Generated by tinty.bootstrap — do not edit manually
# Scheme: ${TINTY_SCHEME_ID:-unknown}
user:
  text: "#${hex0D}"
  background: "default"
group:
  text: "#${hex0C}"
  background: "default"
permission:
  text: "#${hex0B}"
  background: "default"
date:
  text: "#${hex05}"
  background: "default"
file:
  text: "#${hex05}"
  background: "default"
  executable: "#${hex0B}"
  symlink: "#${hex0C}"
  broken: "#${hex08}"
  missing: "#${hex08}"
  file_small: "#${hex05}"
  file_medium: "#${hex09}"
  file_large: "#${hex08}"
directory:
  text: "#${hex0D}"
  background: "default"
context:
  text: "#${hex05}"
  background: "default"
link:
  text: "#${hex0C}"
  background: "default"
device:
  text: "#${hex09}"
  background: "default"
pipe:
  text: "#${hex04}"
  background: "default"
inode:
  text: "#${hex04}"
  background: "default"
EOF

# ---- fzf (custom mapping, no tinted-fzf template) ----
#   hl (match highlight) → base0A (yellow, bold by default)
#   fg+ (current line text) → base0D (blue, regular)
#   fg → base05 (readable text, not base04)
TINTY_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tinted-theming/tinty"
FZF_DIR="$TINTY_DATA_DIR/artifacts"
mkdir -p "$FZF_DIR"

cat > "$FZF_DIR/tinted-fzf-sh-file.sh" <<EOF
# Generated by tinty.bootstrap — custom fzf color mapping
# Scheme: ${TINTY_SCHEME_ID:-unknown}

export FZF_DEFAULT_OPTS="\$FZF_DEFAULT_OPTS"\\
" --color=bg+:#${hex01},bg:#${hex00},spinner:#${hex0C},hl:#${hex0A}"\\
" --color=fg:#${hex05},header:#${hex0D},info:#${hex0A},pointer:#${hex0C}"\\
" --color=marker:#${hex0C},fg+:#${hex0D},prompt:#${hex0A},hl+:#${hex0A}"
EOF
