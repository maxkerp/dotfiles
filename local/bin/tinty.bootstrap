#!/bin/sh
# Post-apply hook for tinty.
# Generates configs for tools without official tinty templates.
set -eu

# tinty *_HEX vars without suffix contain only the red component.
# We need _HEX_{R,G,B} concatenated for full 6-digit hex.
# Defaults are base16-catppuccin-mocha (last applied scheme at install time).
hex00="${TINTY_SCHEME_PALETTE_BASE00_HEX_R:-1e}${TINTY_SCHEME_PALETTE_BASE00_HEX_G:-1e}${TINTY_SCHEME_PALETTE_BASE00_HEX_B:-2e}"
hex01="${TINTY_SCHEME_PALETTE_BASE01_HEX_R:-18}${TINTY_SCHEME_PALETTE_BASE01_HEX_G:-18}${TINTY_SCHEME_PALETTE_BASE01_HEX_B:-25}"
hex02="${TINTY_SCHEME_PALETTE_BASE02_HEX_R:-31}${TINTY_SCHEME_PALETTE_BASE02_HEX_G:-32}${TINTY_SCHEME_PALETTE_BASE02_HEX_B:-44}"
hex03="${TINTY_SCHEME_PALETTE_BASE03_HEX_R:-45}${TINTY_SCHEME_PALETTE_BASE03_HEX_G:-47}${TINTY_SCHEME_PALETTE_BASE03_HEX_B:-5a}"
hex04="${TINTY_SCHEME_PALETTE_BASE04_HEX_R:-58}${TINTY_SCHEME_PALETTE_BASE04_HEX_G:-5b}${TINTY_SCHEME_PALETTE_BASE04_HEX_B:-70}"
hex05="${TINTY_SCHEME_PALETTE_BASE05_HEX_R:-cd}${TINTY_SCHEME_PALETTE_BASE05_HEX_G:-d6}${TINTY_SCHEME_PALETTE_BASE05_HEX_B:-f4}"
hex08="${TINTY_SCHEME_PALETTE_BASE08_HEX_R:-f3}${TINTY_SCHEME_PALETTE_BASE08_HEX_G:-8b}${TINTY_SCHEME_PALETTE_BASE08_HEX_B:-a8}"
hex09="${TINTY_SCHEME_PALETTE_BASE09_HEX_R:-fa}${TINTY_SCHEME_PALETTE_BASE09_HEX_G:-b3}${TINTY_SCHEME_PALETTE_BASE09_HEX_B:-87}"
hex0A="${TINTY_SCHEME_PALETTE_BASE0A_HEX_R:-f9}${TINTY_SCHEME_PALETTE_BASE0A_HEX_G:-e2}${TINTY_SCHEME_PALETTE_BASE0A_HEX_B:-af}"
hex0B="${TINTY_SCHEME_PALETTE_BASE0B_HEX_R:-a6}${TINTY_SCHEME_PALETTE_BASE0B_HEX_G:-e3}${TINTY_SCHEME_PALETTE_BASE0B_HEX_B:-a1}"
hex0C="${TINTY_SCHEME_PALETTE_BASE0C_HEX_R:-94}${TINTY_SCHEME_PALETTE_BASE0C_HEX_G:-e2}${TINTY_SCHEME_PALETTE_BASE0C_HEX_B:-d5}"
hex0D="${TINTY_SCHEME_PALETTE_BASE0D_HEX_R:-89}${TINTY_SCHEME_PALETTE_BASE0D_HEX_G:-b4}${TINTY_SCHEME_PALETTE_BASE0D_HEX_B:-fa}"
hex0E="${TINTY_SCHEME_PALETTE_BASE0E_HEX_R:-cb}${TINTY_SCHEME_PALETTE_BASE0E_HEX_G:-a6}${TINTY_SCHEME_PALETTE_BASE0E_HEX_B:-f7}"

LSD_THEME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lsd/themes"
LSD_THEME_FILE="$LSD_THEME_DIR/base16.yaml"

# ---- lsd theme ----
mkdir -p "$LSD_THEME_DIR"

cat > "$LSD_THEME_FILE" <<EOF
# Generated by tinty.bootstrap — do not edit manually
# Scheme: ${TINTY_SCHEME_ID:-unknown}
user:
  text: "#${hex0D}"
  background: "default"
group:
  text: "#${hex0C}"
  background: "default"
permission:
  text: "#${hex0B}"
  background: "default"
date:
  text: "#${hex05}"
  background: "default"
file:
  text: "#${hex05}"
  background: "default"
  executable: "#${hex0B}"
  symlink: "#${hex0C}"
  broken: "#${hex08}"
  missing: "#${hex08}"
  file_small: "#${hex05}"
  file_medium: "#${hex09}"
  file_large: "#${hex08}"
directory:
  text: "#${hex0D}"
  background: "default"
context:
  text: "#${hex05}"
  background: "default"
link:
  text: "#${hex0C}"
  background: "default"
device:
  text: "#${hex09}"
  background: "default"
pipe:
  text: "#${hex04}"
  background: "default"
inode:
  text: "#${hex04}"
  background: "default"
EOF

# ---- fzf (custom mapping, no tinted-fzf template) ----
#   hl (match highlight) → base0A (yellow, bold by default)
#   fg+ (current line text) → base0D (blue, regular)
#   fg → base05 (readable text, not base04)
TINTY_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tinted-theming/tinty"
FZF_DIR="$TINTY_DATA_DIR/artifacts"
mkdir -p "$FZF_DIR"

cat > "$FZF_DIR/tinted-fzf-sh-file.sh" <<EOF
# Generated by tinty.bootstrap — custom fzf color mapping
# Scheme: ${TINTY_SCHEME_ID:-unknown}

export FZF_DEFAULT_OPTS="\$FZF_DEFAULT_OPTS"\\
" --color=bg+:#${hex01},bg:#${hex00},spinner:#${hex0C},hl:#${hex0A}"\\
" --color=fg:#${hex05},header:#${hex0D},info:#${hex0A},pointer:#${hex0C}"\\
" --color=marker:#${hex0C},fg+:#${hex0D},prompt:#${hex0A},hl+:#${hex0A}"
EOF

# ---- delta (custom, modelled on catppuccin/delta) ----
_blend() { echo $(($1 * $3 / 100 + $2 * (100 - $3) / 100)); }

_dbg_R=${TINTY_SCHEME_PALETTE_BASE00_RGB_R:-30}
_dbg_G=${TINTY_SCHEME_PALETTE_BASE00_RGB_G:-30}
_dbg_B=${TINTY_SCHEME_PALETTE_BASE00_RGB_B:-46}
_dred_R=${TINTY_SCHEME_PALETTE_BASE08_RGB_R:-243}
_dred_G=${TINTY_SCHEME_PALETTE_BASE08_RGB_G:-139}
_dred_B=${TINTY_SCHEME_PALETTE_BASE08_RGB_B:-168}
_dgrn_R=${TINTY_SCHEME_PALETTE_BASE0B_RGB_R:-166}
_dgrn_G=${TINTY_SCHEME_PALETTE_BASE0B_RGB_G:-227}
_dgrn_B=${TINTY_SCHEME_PALETTE_BASE0B_RGB_B:-161}

# map-styles: base0E (mauve), base0D (blue), base0C (cyan), base0A (yellow) @ 35%
_dmp_R=${TINTY_SCHEME_PALETTE_BASE0E_RGB_R:-203}
_dmp_G=${TINTY_SCHEME_PALETTE_BASE0E_RGB_G:-166}
_dmp_B=${TINTY_SCHEME_PALETTE_BASE0E_RGB_B:-247}
_dmb_R=${TINTY_SCHEME_PALETTE_BASE0D_RGB_R:-137}
_dmb_G=${TINTY_SCHEME_PALETTE_BASE0D_RGB_G:-180}
_dmb_B=${TINTY_SCHEME_PALETTE_BASE0D_RGB_B:-250}
_dmc_R=${TINTY_SCHEME_PALETTE_BASE0C_RGB_R:-148}
_dmc_G=${TINTY_SCHEME_PALETTE_BASE0C_RGB_G:-226}
_dmc_B=${TINTY_SCHEME_PALETTE_BASE0C_RGB_B:-213}
_dmy_R=${TINTY_SCHEME_PALETTE_BASE0A_RGB_R:-249}
_dmy_G=${TINTY_SCHEME_PALETTE_BASE0A_RGB_G:-226}
_dmy_B=${TINTY_SCHEME_PALETTE_BASE0A_RGB_B:-175}

min20=$(printf "#%02x%02x%02x" $(_blend $_dred_R $_dbg_R 20) $(_blend $_dred_G $_dbg_G 20) $(_blend $_dred_B $_dbg_B 20))
min35=$(printf "#%02x%02x%02x" $(_blend $_dred_R $_dbg_R 35) $(_blend $_dred_G $_dbg_G 35) $(_blend $_dred_B $_dbg_B 35))
plu20=$(printf "#%02x%02x%02x" $(_blend $_dgrn_R $_dbg_R 20) $(_blend $_dgrn_G $_dbg_G 20) $(_blend $_dgrn_B $_dbg_B 20))
plu35=$(printf "#%02x%02x%02x" $(_blend $_dgrn_R $_dbg_R 35) $(_blend $_dgrn_G $_dbg_G 35) $(_blend $_dgrn_B $_dbg_B 35))

mpe35=$(printf "#%02x%02x%02x" $(_blend $_dmp_R $_dbg_R 35) $(_blend $_dmp_G $_dbg_G 35) $(_blend $_dmp_B $_dbg_B 35))
mbl35=$(printf "#%02x%02x%02x" $(_blend $_dmb_R $_dbg_R 35) $(_blend $_dmb_G $_dbg_G 35) $(_blend $_dmb_B $_dbg_B 35))
mcy35=$(printf "#%02x%02x%02x" $(_blend $_dmc_R $_dbg_R 35) $(_blend $_dmc_G $_dbg_G 35) $(_blend $_dmc_B $_dbg_B 35))
mye35=$(printf "#%02x%02x%02x" $(_blend $_dmy_R $_dbg_R 35) $(_blend $_dmy_G $_dbg_G 35) $(_blend $_dmy_B $_dbg_B 35))

case "${TINTY_SCHEME_VARIANT:-dark}" in
  light) dlt=true ;;
  *) dlt=false ;;
esac

cat > "$TINTY_DATA_DIR/tinted-delta-configs-file.gitconfig" <<EOF
# Generated by tinty.bootstrap

[delta]
	syntax-theme = "base16-256"
	light = ${dlt}

	blame-palette = "#${hex00} #${hex01} #${hex02} #${hex03} #${hex04}"
	commit-decoration-style = "#${hex04}" bold box ul
	file-decoration-style = "#${hex04}"
	file-style = "#${hex05}"
	hunk-header-decoration-style = "#${hex04}" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#${hex04}"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#${hex04}"
	line-numbers-minus-style = bold "#${hex08}"
	line-numbers-plus-style = bold "#${hex0B}"
	line-numbers-right-style = "#${hex04}"
	line-numbers-zero-style = "#${hex04}"
	# 35% red 65% base
	minus-emph-style = bold syntax "${min35}"
	# 20% red 80% base
	minus-style = syntax "${min20}"
	# 35% green 65% base
	plus-emph-style = bold syntax "${plu35}"
	# 20% green 80% base
	plus-style = syntax "${plu20}"
	map-styles = bold purple => syntax "${mpe35}", bold blue => syntax "${mbl35}", bold cyan => syntax "${mcy35}", bold yellow => syntax "${mye35}"
EOF

# ---- tmux status bar (scheme-aware override, sourced by status.conf) ----
TINTY_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tinted-theming/tinty"
TMUX_ARTIFACTS_DIR="$TINTY_DATA_DIR/artifacts"
mkdir -p "$TMUX_ARTIFACTS_DIR"

cat > "$TMUX_ARTIFACTS_DIR/tmux-status-custom.conf" <<EOF
# Generated by tinty.bootstrap — scheme-aware status bar colors
# Source: config/tmux/status.conf sources this file on startup.

set -g status-style "fg=#${hex04},bg=#${hex01}"

set -g window-status-format \\
  " #[fg=#${hex04},bg=#${hex01}] #W "
set -g window-status-current-format \\
  " #[fg=#${hex00},bg=#${hex0E}] #W "
set -g window-status-current-style "fg=#${hex0E},bg=#${hex01}"
set -g window-status-last-style "fg=#${hex0C},bg=#${hex01}"

set -g status-left "#[fg=#${hex00},bg=#${hex0D}] #S "
set -g status-right "#[fg=#${hex05},bg=#${hex01}] #(battery-status)  %d-%m %H:%M "
EOF

unset _blend _dbg_R _dbg_G _dbg_B _dred_R _dred_G _dred_B _dgrn_R _dgrn_G _dgrn_B _dmp_R _dmp_G _dmp_B _dmb_R _dmb_G _dmb_B _dmc_R _dmc_G _dmc_B _dmy_R _dmy_G _dmy_B min20 min35 plu20 plu35 mpe35 mbl35 mcy35 mye35 dlt TMUX_ARTIFACTS_DIR
