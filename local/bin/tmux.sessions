#!/bin/bash
GIT_DIR="$HOME/Git"

# Collect active session names
active_sessions=()
while IFS= read -r s; do
  active_sessions+=("$s")
done < <(tmux list-sessions -F '#S' 2>/dev/null)

# Scan git repos, keyed by normalized name (. → -)
declare -A repo_group
declare -A repo_path
declare -A repo_orig
declare -A repo_display
repo_norms=()

for item in "$GIT_DIR"/*; do
  [ -d "$item" ] || continue
  base=$(basename "$item")
  base_norm="${base//./-}"
  if [ -d "$item/.git" ] || git -C "$item" rev-parse --git-dir >/dev/null 2>&1; then
    repo_group[$base_norm]=""
    repo_path[$base_norm]="$item"
    repo_orig[$base_norm]="$base"
    repo_display[$base_norm]="$base"
    repo_norms+=("$base_norm")
  else
    for child in "$item"/*; do
      [ -d "$child" ] || continue
      if [ -d "$child/.git" ] || git -C "$child" rev-parse --git-dir >/dev/null 2>&1; then
        cbase=$(basename "$child")
        cbase_norm="${cbase//./-}"
        parent=$(basename "$item")
        repo_group[$cbase_norm]="$parent"
        repo_path[$cbase_norm]="$child"
        repo_orig[$cbase_norm]="$cbase"
        repo_display[$cbase_norm]="$cbase"
        repo_norms+=("$cbase_norm")
      fi
    done
  fi
done

# Find longest name for alignment (use original/display names)
max_len=0
for s in "${active_sessions[@]}"; do
  (( ${#s} > max_len )) && max_len=${#s}
done
for n in "${repo_norms[@]}"; do
  (( ${#repo_display[$n]} > max_len )) && max_len=${#repo_display[$n]}
done

t=$'\t'
items=""
pad=$(( max_len + 1 ))

# --- Build fzf list ---

for s in "${active_sessions[@]}"; do
  s_norm="${s//./-}"
  group="${repo_group[$s_norm]}"
  if [ -n "$group" ]; then
    items+="$(printf "%-${pad}s${t}%s${t}" "$s" "$group")$s"$'\n'
  else
    items+="$(printf "%-${pad}s${t}${t}" "$s")$s"$'\n'
  fi
done

items+="${t}${t}"$'\n'
items+="--------------------------------${t}${t}"$'\n'

# Sort normalized names for deterministic ordering
readarray -t sorted_repos < <(printf '%s\n' "${repo_norms[@]}" | sort)

for norm in "${sorted_repos[@]}"; do
  is_active=false
  for s in "${active_sessions[@]}"; do
    s_norm="${s//./-}"
    [ "$norm" = "$s_norm" ] && is_active=true && break
  done
  $is_active && continue

  display="${repo_display[$norm]}"
  group="${repo_group[$norm]}"
  if [ -n "$group" ]; then
    items+="$(printf "%-${pad}s${t}%s${t}" "$display" "$group")${repo_path[$norm]}"$'\n'
  else
    items+="$(printf "%-${pad}s${t}${t}" "$display")${repo_path[$norm]}"$'\n'
  fi
done

selection=$(echo -n "$items" | fzf --header="  Active Sessions" --delimiter="$t" --with-nth=1,2 --tiebreak=index --color=16 --height=40% --reverse)

if [ -n "$selection" ]; then
  action=$(echo "$selection" | cut -f3)
  if [ -n "$action" ]; then
    tmux.attach "$action"
  fi
fi
